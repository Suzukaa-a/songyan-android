{
  "formatVersion" : 1,
  "id" : "canonical",
  "name" : {
    "en" : "Typeset tidy",
    "ja" : "組版を整える",
    "zh-Hans" : "排版整理",
    "zh-Hant" : "排版整理"
  },
  "steps" : [
    {
      "config" : "s2twp",
      "type" : "opencc"
    },
    {
      "pattern" : "\\s+",
      "replacement" : " ",
      "type" : "replace"
    },
    {
      "table" : {
        "。" : ". ",
        "，" : ", ",
        "；" : "; "
      },
      "type" : "map"
    },
    {
      "mode" : "capitalize",
      "type" : "case"
    },
    {
      "mode" : "toHalf",
      "type" : "width"
    },
    {
      "pattern" : "「{text}」",
      "type" : "template"
    }
  ]
}