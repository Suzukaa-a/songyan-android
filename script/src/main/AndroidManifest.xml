<?xml version="1.0" encoding="utf-8"?>
<!-- Two processes: the proxy (ordinary, owns storage, secrets and the network transport) and the
     isolated service (no permissions, runs the JS engine and nothing else). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The proxy process performs the scripts' declared network requests; the IME process never
         holds this permission's use for script fetches (it does not load the engine at all). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android allows cleartext per app, not per process, so this applies to the whole app. Only
         the script transport uses it: ScriptAddressPolicy lets plain http through only to a local
         address the user typed into a script's settings. Every other download in the app checks
         for https in code (ScriptFetcher, scheme and dictionary links) and refuses http. -->
    <application android:usesCleartextTraffic="true">
        <service
            android:name="app.songyan.ime.script.ScriptIsolatedService"
            android:exported="false"
            android:isolatedProcess="true" />
        <service
            android:name="app.songyan.ime.script.ScriptProxyService"
            android:exported="false"
            android:process=":script" />
    </application>

</manifest>
