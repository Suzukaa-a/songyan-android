<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- キーボードツール：テキストを渡せるほかのアプリ -->
    <string name="tools_process_text_section">ほかのアプリ</string>
    <string name="tools_process_text_body">アプリをオンにすると、キーボードで選択したテキストまたは入力欄全体をそのアプリに渡せます。返ってきた内容はプレビューだけで、選んでから書き込みます。</string>
    <string name="tools_process_text_switch">%1$s を使う</string>
    <string name="tools_process_text_empty">この端末にテキストを扱うアプリはありません。</string>
    <string name="tools_process_text_unavailable">テキストを扱うアプリを読み取れませんでした。</string>
    <string name="tools_speech_section">音声入力</string>
    <string name="tools_speech_body">音声入力アプリをオンにすると、キーボードから音声で入力できます。認識したテキストはプレビューだけで、挿入を選んでから書き込みます。</string>
    <string name="tools_speech_switch">%1$s を使う</string>
    <string name="tools_speech_empty">この端末に音声入力アプリはありません。</string>
    <string name="tools_speech_unavailable">音声入力アプリを読み取れませんでした。</string>
</resources>
